# Supabase — copy from your PillID Supabase project
# Paste into app.json > extra, or use eas.json for build-time env injection
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx

# The Gemma 4B Q4_K_M model (~2.6 GB) and its vision projector (~620 MB)
# are downloaded on first launch from HuggingFace and cached on-device.
# No Ollama server required.
