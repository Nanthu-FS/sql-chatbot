DB_HOST=<your_db_host>
DB_PORT=<your_db_port>
DB_USER=<your_db_user>
DB_PASSWORD=<your_db_password>
DB_NAME=<your_database_name>
OLLAMA_MODEL=llama3.2:3b

# ── Polymarket Bot ────────────────────────────────────────────────────────────
# Local Ollama model — pull with: ollama pull qwen2.5:14b
# Options: qwen2.5:14b, qwen2.5:32b, deepseek-r1:14b, llama3.3:70b
POLYMARKET_MODEL=qwen2.5:14b
OLLAMA_HOST=http://localhost:11434

# ── DANGER — Wallet credentials ───────────────────────────────────────────────
# SECURITY WARNING: Your POLY_PRIVATE_KEY controls real funds on Polygon.
#   • Never commit this file to version control.
#   • Never share it or paste it into chat/logs/issues.
#   • Use a DEDICATED bot wallet — never your main wallet.
#   • Store a minimal USDC balance (only what the bot may trade).
#   • If this key is exposed, move funds immediately and rotate credentials.
# ─────────────────────────────────────────────────────────────────────────────
POLY_PRIVATE_KEY=0x...
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Markets to focus on (comma-separated: Politics, World Events, Crypto, Sports)
POLY_CATEGORIES=Politics,World Events

# Risk settings
MIN_VOLUME_USD=100000
MAX_OPEN_POSITIONS=5
MAX_RISK_PER_TRADE=0.01
CONFIDENCE_THRESHOLD=0.90
DAILY_LOSS_LIMIT=0.03

# Optional: password-protect the Streamlit UI (VULN-02)
# Set a strong password here to require login before accessing the bot.
APP_PASSWORD=

# Email alerts (optional — uses Gmail App Password)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
